# Copy to .env and fill in. NEVER commit .env

# --- Dev 3: from Meta Developer Dashboard ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=govtech_verify_123

# --- Dev 1: local Ollama ---
OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:4b-instruct

# Set to true until the vision model is downloaded and working.
# Dev 2 and Dev 4 keep this true all the way to hour 10.
USE_MOCK=true

# --- B10: local speech-to-text (python stt/server.py) ---
STT_URL=http://localhost:5005
USE_MOCK_STT=true
# "small" is the floor for Indic languages. "base" is faster but much worse on Devanagari.
STT_MODEL=small
# CPU keeps the 6GB GPU free for the VLM, which needs it more.
STT_DEVICE=cpu
STT_COMPUTE=int8

PORT=3000
